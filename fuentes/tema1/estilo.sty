% =====================================================================
%  estilo.sty -- Apuntes formalizados, Termodinámica I (USAL)
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{estilo}

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[spanish,es-noshorthands,es-tabla]{babel}
\RequirePackage{lmodern}
\RequirePackage[protrusion=true,expansion=true,letterspace=150]{microtype}
\RequirePackage[a4paper,top=2.6cm,bottom=2.6cm,left=2.5cm,right=2.5cm,headheight=15pt,headsep=0.9cm]{geometry}
\RequirePackage{amsmath,amssymb,mathtools,bm}
\RequirePackage{amsthm}
\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{booktabs,array,tabularx}
\RequirePackage{enumitem}
\RequirePackage{caption,subcaption}
\RequirePackage{titlesec,titletoc}
\RequirePackage{fancyhdr}
\RequirePackage{extramarks}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\RequirePackage{pgfplots}
\RequirePackage{siunitx}
\RequirePackage{needspace}
\RequirePackage{placeins}
\RequirePackage{float}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.85}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{4}
\RequirePackage{multicol}
\RequirePackage{xspace}
\RequirePackage{etoolbox}
\RequirePackage[hidelinks]{hyperref}

\pgfplotsset{compat=1.18}
\pgfplotsset{graf/.style={width=8.2cm,height=5.6cm,axis line style={navy},
    tick label style={font=\scriptsize},label style={font=\small},
    every axis plot/.append style={thick},
    legend cell align=left,
    legend style={font=\scriptsize,draw=regla,fill=white,inner sep=2pt,row sep=1pt},
    /pgf/number format/use comma,/pgf/number format/1000 sep={\,}},
  leyenda fuera/.style={legend style={at={(1.04,1)},anchor=north west}},
  leyenda abajo/.style={legend style={at={(0.5,-0.28)},anchor=north,legend columns=-1,/tikz/every even column/.append style={column sep=8pt}}}}
\usetikzlibrary{arrows.meta,calc,positioning,decorations.pathmorphing,decorations.markings,patterns,shapes.geometric,fit,backgrounds}
\usepgfplotslibrary{fillbetween,groupplots}

\sisetup{output-decimal-marker={,},group-separator={\,},inter-unit-product=\ensuremath{\,},
  per-mode=symbol,exponent-product=\cdot,range-phrase=--}

% ---------------------------------------------------------------------
%  Colores
% ---------------------------------------------------------------------
\definecolor{navy}{RGB}{11,37,69}
\definecolor{acento}{RGB}{58,110,165}
\definecolor{acentomedio}{RGB}{76,113,161}
\definecolor{acentoclaro}{RGB}{157,183,210}
\definecolor{fondo}{RGB}{241,245,251}
\definecolor{fondomedio}{RGB}{225,234,246}
\definecolor{regla}{RGB}{188,208,234}
\definecolor{rojo}{RGB}{181,82,59}
\definecolor{gris}{RGB}{110,125,145}
\definecolor{verde}{RGB}{62,128,96}

\hypersetup{colorlinks=true,linkcolor=acento,citecolor=acento,urlcolor=acento}

% ---------------------------------------------------------------------
%  Utilidades tipográficas
% ---------------------------------------------------------------------
\newcommand{\espaciado}[2][180]{\textls[#1]{\textsc{#2}}}
\newcommand{\Vm}{\bar{V}}
\newcommand{\dd}{\mathrm{d}}
\newcommand{\e}{\mathrm{e}}
\newcommand{\cte}{\mathrm{cte}}
\newcommand{\pd}[3]{\left(\frac{\partial #1}{\partial #2}\right)_{\!#3}}
\newcommand{\pdi}[3]{\bigl(\tfrac{\partial #1}{\partial #2}\bigr)_{#3}}
\newcommand{\paso}[1]{\par\smallskip\noindent{\bfseries\color{navy}#1.}\enspace\ignorespaces}
\newcommand{\idea}{\noindent{\color{acento}\itshape Resolución.}\enspace\textbf{Idea.}\enspace\ignorespaces}
\newcommand{\cajares}[1]{\fcolorbox{navy}{white}{\(\displaystyle #1\)}}
\newcommand{\chk}{\ \checkmark}
\newcommand{\sepdot}{\ \textperiodcentered\ }
\newcommand{\nota}[1]{\text{\small\color{gris}\itshape #1}}

\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\linespread{1.06}

\captionsetup{font=small,labelfont={color=acento,sc},labelsep=period,justification=justified,singlelinecheck=true}
\captionsetup[table]{position=top,skip=6pt}
\captionsetup[subfigure]{labelformat=parens,labelfont={color=acento,sc},font=footnotesize,justification=centering}
\renewcommand{\thesubfigure}{\textsc{\alph{subfigure}}}
\DeclareCaptionLabelFormat{simple}{#1~#2}

\setlist{itemsep=2pt,topsep=4pt}

% ---------------------------------------------------------------------
%  Secciones
% ---------------------------------------------------------------------
\titleformat{\section}{\Large\bfseries\color{navy}}{\thesection.}{0.6em}{}[\vspace{2pt}{\color{navy}\titlerule[0.9pt]}]
\titlespacing*{\section}{0pt}{20pt plus 4pt minus 2pt}{10pt}
\titleformat{\subsection}{\large\bfseries\color{navy}}{\thesubsection.}{0.6em}{}
\titlespacing*{\subsection}{0pt}{14pt plus 3pt minus 2pt}{6pt}
\titleformat{\subsubsection}{\normalsize\bfseries\color{navy}}{\thesubsubsection.}{0.6em}{}

% Índice
\titlecontents{section}[0em]{\addvspace{6pt}\bfseries\color{acento}}
  {\contentslabel[\thecontentslabel.]{1.5em}}{}{\hfill\contentspage}
\titlecontents{subsection}[1.5em]{\color{acento}}
  {\contentslabel[\thecontentslabel.]{2.6em}}{}{\titlerule*[0.6pc]{.}\contentspage}

% ---------------------------------------------------------------------
%  Cabeceras
% ---------------------------------------------------------------------
\newcommand{\cabeceraizq}{\espaciado[60]{Termodinámica I}\enspace\textperiodcentered\enspace\espaciado[60]{Tema 1}}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\color{acento}\cabeceraizq}
\fancyhead[R]{\color{acento}\textsc{\nouppercase{\firstleftmark}}}
\fancyfoot[C]{\color{navy}\small\thepage}
\renewcommand{\headrule}{\vspace{-2pt}{\color{regla}\hrule height 0.6pt}}
\renewcommand{\sectionmark}[1]{\markboth{#1}{}}

% ---------------------------------------------------------------------
%  Entornos tipo teorema
% ---------------------------------------------------------------------
\newcounter{entorno}[section]
\renewcommand{\theentorno}{\thesection.\arabic{entorno}}

\tcbset{
  cajabase/.style={enhanced,breakable,frame hidden,boxrule=0pt,sharp corners,
    borderline west={3pt}{0pt}{navy},
    colback=fondo,interior style={left color=fondo,right color=fondo!35!white},
    left=10pt,right=10pt,top=7pt,bottom=7pt,before skip=10pt,after skip=10pt,
    fontupper=\normalfont},
}

% titulo: \begin{definicion}[título] ...
\newcommand{\cabentorno}[3]{{\bfseries\color{navy}#1~#2}\ifstrempty{#3}{}{\ {\color{acento}(#3)}}{\bfseries.}\enspace}

\NewDocumentEnvironment{definicion}{o}
  {\refstepcounter{entorno}\begin{tcolorbox}[cajabase]\cabentorno{Definición}{\theentorno}{\IfValueT{#1}{#1}}\ignorespaces}
  {\end{tcolorbox}}
\NewDocumentEnvironment{teorema}{o}
  {\refstepcounter{entorno}\begin{tcolorbox}[cajabase]\cabentorno{Teorema}{\theentorno}{\IfValueT{#1}{#1}}\itshape\ignorespaces}
  {\end{tcolorbox}}
\NewDocumentEnvironment{proposicion}{o}
  {\refstepcounter{entorno}\par\medskip\noindent\cabentorno{Proposición}{\theentorno}{\IfValueT{#1}{#1}}\itshape\ignorespaces}
  {\par\medskip}
\NewDocumentEnvironment{observacion}{o}
  {\refstepcounter{entorno}\par\medskip\noindent{\color{acento}\itshape Observación~\theentorno\IfValueT{#1}{\ (#1)}.}\enspace\ignorespaces}
  {\par\medskip}
\NewDocumentEnvironment{ejemplo}{o}
  {\refstepcounter{entorno}\par\medskip\noindent\cabentorno{Ejemplo}{\theentorno}{\IfValueT{#1}{#1}}\ignorespaces}
  {\finprueba\par\medskip}

\newcommand{\finprueba}{\ifmmode\else\unskip\nobreak\fi\hfill\nobreak{\color{acentomedio}\rule{1.3ex}{1.3ex}}}
\NewDocumentEnvironment{demostracion}{}
  {\par\smallskip\noindent{\color{acento}\itshape Demostración.}\enspace\ignorespaces}
  {\finprueba\par\medskip}

% Problemas
\NewDocumentEnvironment{problema}{m m}
  {\begin{tcolorbox}[cajabase,breakable=false]\cabentorno{Problema}{#1}{#2}\itshape\ignorespaces}
  {\end{tcolorbox}}
\NewDocumentEnvironment{resolucion}{}
  {\par\noindent\ignorespaces}
  {\finprueba\par\medskip}

% Recuadros de método (sin numerar)
\NewDocumentEnvironment{recuadro}{m}
  {\begin{tcolorbox}[cajabase,breakable=false,top=9pt,bottom=9pt]{\color{acento}\espaciado[200]{#1}}\par\medskip\ignorespaces}
  {\end{tcolorbox}}

% Ecuaciones: número a la derecha, en negro
\numberwithin{equation}{section}
\renewcommand{\theequation}{\arabic{equation}}
\counterwithout{equation}{section}

% Las figuras no abandonan su subsección
\pretocmd{\subsection}{\FloatBarrier}{}{}
\pretocmd{\section}{\FloatBarrier}{}{}

\endinput
